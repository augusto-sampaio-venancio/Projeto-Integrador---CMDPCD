<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Se o arquivo ou diretório existir fisicamente, serve ele diretamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Caso contrário, envia para o Front Controller index.php
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
